{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Regional audit and alerting lab for Secrets Manager and GuardDuty. Charges apply.",
  "Parameters": {
    "AlertEmail": {
      "Type": "String",
      "Description": "Email address to confirm the SNS subscription",
      "AllowedPattern": "[^\\s@]+@[^\\s@]+\\.[^\\s@]+"
    },
    "CreateGuardDutyDetector": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "true only if GuardDuty is not already enabled in this region"
    }
  },
  "Conditions": {
    "CreateDetector": {
      "Fn::Equals": [
        {
          "Ref": "CreateGuardDutyDetector"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "AuditBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireLabLogs",
              "Status": "Enabled",
              "ExpirationInDays": 30,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AuditLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },
    "AuditBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AuditBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AuditBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${AuditBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": "s3:GetBucketAcl",
              "Resource": {
                "Fn::GetAtt": [
                  "AuditBucket",
                  "Arn"
                ]
              },
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/${AWS::StackName}-audit"
                  }
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${AuditBucket.Arn}/AWSLogs/${AWS::AccountId}/*"
              },
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/${AWS::StackName}-audit"
                  },
                  "s3:x-amz-acl": "bucket-owner-full-control"
                }
              }
            }
          ]
        }
      }
    },
    "TrailLogRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WriteAuditLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AuditLogGroup",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Trail": {
      "Type": "AWS::CloudTrail::Trail",
      "Properties": {
        "TrailName": {
          "Fn::Sub": "${AWS::StackName}-audit"
        },
        "S3BucketName": {
          "Ref": "AuditBucket"
        },
        "IsLogging": true,
        "IsMultiRegionTrail": false,
        "IncludeGlobalServiceEvents": false,
        "EnableLogFileValidation": true,
        "CloudWatchLogsLogGroupArn": {
          "Fn::GetAtt": [
            "AuditLogGroup",
            "Arn"
          ]
        },
        "CloudWatchLogsRoleArn": {
          "Fn::GetAtt": [
            "TrailLogRole",
            "Arn"
          ]
        },
        "EventSelectors": [
          {
            "ReadWriteType": "All",
            "IncludeManagementEvents": true
          }
        ]
      },
      "DependsOn": "AuditBucketPolicy"
    },
    "LabSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Generated dummy secret for the monitoring lab. Never use production data.",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"purpose\":\"portfolio-lab\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      }
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "Subscription": [
          {
            "Protocol": "email",
            "Endpoint": {
              "Ref": "AlertEmail"
            }
          }
        ]
      }
    },
    "ReadFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "AuditLogGroup"
        },
        "FilterPattern": "{ ($.eventSource = \"secretsmanager.amazonaws.com\") && ($.eventName = \"GetSecretValue\") && ($.errorCode NOT EXISTS) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/Security"
            },
            "MetricName": "SuccessfulSecretReads",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "DeniedFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "AuditLogGroup"
        },
        "FilterPattern": "{ ($.eventSource = \"secretsmanager.amazonaws.com\") && ($.eventName = \"GetSecretValue\") && ($.errorCode = \"AccessDenied*\") }",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/Security"
            },
            "MetricName": "DeniedSecretReads",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "ReadAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Lab: at least one SuccessfulSecretReads in the region; notifications on state transition.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/Security"
        },
        "MetricName": "SuccessfulSecretReads",
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "DeniedAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Lab: at least one DeniedSecretReads in the region; notifications on state transition.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/Security"
        },
        "MetricName": "DeniedSecretReads",
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "GuardDuty": {
      "Type": "AWS::GuardDuty::Detector",
      "Properties": {
        "Enable": true,
        "FindingPublishingFrequency": "FIFTEEN_MINUTES"
      },
      "Condition": "CreateDetector"
    },
    "FindingRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Medium and higher severity GuardDuty findings, including samples",
        "State": "ENABLED",
        "EventPattern": {
          "source": [
            "aws.guardduty"
          ],
          "detail-type": [
            "GuardDuty Finding"
          ],
          "detail": {
            "severity": [
              {
                "numeric": [
                  ">=",
                  4
                ]
              }
            ]
          }
        },
        "Targets": [
          {
            "Id": "Notify",
            "Arn": {
              "Ref": "Alerts"
            }
          }
        ]
      }
    },
    "TopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "Alerts"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "Alerts"
              },
              "Principal": {
                "Service": "events.amazonaws.com"
              }
            },
            {
              "Effect": "Allow",
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "Alerts"
              },
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": [
                    {
                      "Fn::GetAtt": [
                        "ReadAlarm",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "DeniedAlarm",
                        "Arn"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "DeniedTestRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DenyDummySecretRead",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Deny",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "LabSecret"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "SecretArn": {
      "Value": {
        "Ref": "LabSecret"
      }
    },
    "AuditBucketName": {
      "Value": {
        "Ref": "AuditBucket"
      }
    },
    "AuditLogGroup": {
      "Value": {
        "Ref": "AuditLogGroup"
      }
    },
    "TopicArn": {
      "Value": {
        "Ref": "Alerts"
      }
    },
    "TrailName": {
      "Value": {
        "Ref": "Trail"
      }
    },
    "ReadAlarmName": {
      "Value": {
        "Ref": "ReadAlarm"
      }
    },
    "DeniedAlarmName": {
      "Value": {
        "Ref": "DeniedAlarm"
      }
    },
    "DeniedTestRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeniedTestRole",
          "Arn"
        ]
      }
    },
    "FindingRuleName": {
      "Value": {
        "Ref": "FindingRule"
      }
    },
    "DetectorId": {
      "Condition": "CreateDetector",
      "Value": {
        "Ref": "GuardDuty"
      }
    }
  }
}
