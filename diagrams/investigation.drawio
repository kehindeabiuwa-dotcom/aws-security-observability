  <diagram name="A finding starts an investigation." id="investigation">
    <mxGraphModel dx="1600" dy="1000" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="A finding starts an investigation.&#10;Keep sample findings visibly marked • preserve evidence before changing resources" style="text;html=0;align=left;fontSize=30;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="25" width="1530" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=16;" edge="1" parent="1" source="notice" target="context">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=16;" edge="1" parent="1" source="context" target="compare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=16;" edge="1" parent="1" source="compare" target="decide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=16;" edge="1" parent="1" source="compare" target="scope">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notice" value="Receive notification&#10;Identify path and region&#10;Sample or real event?" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c95166;strokeWidth=2;fontSize=22;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="55" y="285" width="325" height="155" as="geometry" />
        </mxCell>
        <mxCell id="context" value="Establish context&#10;Who / what / when&#10;Affected resource + source" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#2477c8;strokeWidth=2;fontSize=22;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="445" y="285" width="325" height="155" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="Correlate evidence&#10;Authorized test or activity?&#10;CloudTrail + finding detail" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#7855b5;strokeWidth=2;fontSize=22;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="835" y="285" width="325" height="155" as="geometry" />
        </mxCell>
        <mxCell id="decide" value="Document decision&#10;Expected / suspicious&#10;Uncertainties + next steps" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#249676;strokeWidth=2;fontSize=22;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1225" y="285" width="325" height="155" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="Baseline scope: observe and notify&#10;Sample findings validate routing, not real attack detection.&#10;Containment and credential revocation are outside this automated baseline." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#df872b;strokeWidth=2;fontSize=22;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="360" y="670" width="880" height="150" as="geometry" />
